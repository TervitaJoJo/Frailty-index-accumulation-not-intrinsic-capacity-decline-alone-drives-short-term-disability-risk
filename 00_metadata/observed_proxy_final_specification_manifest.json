{
  "manifest_name": "observed_proxy_final_specification_manifest",
  "manifest_version": "1.0",
  "status": "frozen_for_analysis_reproducibility; manuscript and submission files are outside this code bundle",
  "frozen_at_utc": "2026-09-25T12:15:06.686128+00:00",
  "project_scope": "Age and Ageing IC/Frailty project; Differentiaion/AJPH excluded",
  "estimand": {
    "primary_question": "Does baseline four-domain observed IC proxy information add incremental prediction of incident disability beyond age, sex, education and baseline outcome-disjoint FI?",
    "primary_outcome": "new any ADL/IADL limitation during one fixed follow-up window among participants free of ADL/IADL limitation at baseline",
    "primary_cohorts": [
      "ELSA 6->7",
      "CHARLS 3->4",
      "HRS 10->11"
    ],
    "external_validation": [
      "SHARE 6->7 primary",
      "SHARE 6->8 sensitivity"
    ],
    "model_type": "fixed-window logistic regression; horizon AUC is equivalent to a fixed-window discrimination statistic, not a continuous-time survival C-index",
    "mortality": "separate fixed-window competing-event sensitivity; not part of the frozen primary model"
  },
  "sample_rules": {
    "baseline_disability": "exclude any baseline ADL/IADL limitation using cohort-specific harmonized summaries",
    "future_outcome": "require observed follow-up ADL/IADL summaries; event is any new limitation",
    "hrs_ic": "exclude proxy respondents at baseline and follow-up for IC measurement/prediction; proxy respondents may remain in FI-only descriptive sensitivity",
    "share": "14 consistently observed ADL/IADL items; at least 10 observed items per person-wave; housework item excluded for structural sparsity",
    "share_wave7": "excluded from primary longitudinal cognition analyses, but retained for this disability external validation because the endpoint/model is explicitly audited for structural missingness"
  },
  "frailty_definition": {
    "name": "outcome-disjoint eight-component comparator FI",
    "components": [
      "hypertension",
      "diabetes",
      "heart_disease",
      "stroke",
      "cancer",
      "arthritis",
      "self_rated_health",
      "BMI"
    ],
    "minimum_observed_components": 6,
    "denominator": "number of observed components",
    "self_rated_health_deficit": "(poor health scale - 1) / 4",
    "bmi_deficit": "BMI < 18.5 or BMI >= 30",
    "excluded_from_fi": [
      "cognition",
      "locomotion",
      "grip_vitality",
      "psychological",
      "sensory",
      "ADL/IADL",
      "death"
    ],
    "interpretation": "outcome-disjoint comparator rather than a complete universal clinical frailty index"
  },
  "predictors": {
    "base": [
      "age",
      "sex",
      "education",
      "baseline_outcome_disjoint_FI"
    ],
    "incremental": [
      "cognition_proxy",
      "locomotion_proxy",
      "grip_vitality_proxy",
      "psychological_proxy"
    ],
    "full": [
      "age",
      "sex",
      "education",
      "baseline_outcome_disjoint_FI",
      "cognition_proxy",
      "locomotion_proxy",
      "grip_vitality_proxy",
      "psychological_proxy"
    ],
    "direction": "all four domain proxies are coded so higher values indicate greater capacity",
    "standardisation": "continuous predictors are z-standardised separately within each cohort-window; binary sex remains unstandardised",
    "external_validation": "SHARE uses its own within-window standardisation parameters while pooled development coefficients and intercept are held fixed"
  },
  "analysis_extensions": {
    "internal_apparent": "cohort-specific base/full fits",
    "pooled_development": "ELSA + CHARLS + HRS complete predictor sample",
    "leave_one_cohort_out": "train on two primary cohorts and validate in the held-out primary cohort; within-cohort standardisation is primary, pooled-reference scaling is boundary sensitivity",
    "optimism": "400-replicate pooled bootstrap",
    "missingness": "baseline-observable IPW sensitivity; ordinal-compatible MI is a separate bounded longitudinal FI sensitivity, not a replacement for the disability primary model",
    "calibration": [
      "intercept",
      "slope",
      "observed/expected ratio",
      "risk deciles/quintiles"
    ],
    "decision_curve": "exploratory only; no clinical treatment/referral threshold is claimed"
  },
  "ordinal_mi_sensitivity": {
    "estimand": "future outcome-disjoint FI adjusted for baseline FI, age and sex plus four observed IC proxies",
    "cohorts": [
      "ELSA 6->7",
      "CHARLS 3->4",
      "HRS 10->11"
    ],
    "m": 5,
    "maxit": 3,
    "seed": 20260925,
    "methods": {
      "multilevel_ordinal": "polr",
      "two_level_and_binary": "logreg.boot",
      "continuous_age_grip_bmi": "pmm"
    },
    "passive_recomputation": [
      "four IC proxies",
      "baseline FI",
      "future FI"
    ],
    "structural_missingness": "not recoverable by imputation; CHARLS future self-rated-health/BMI remain structurally unavailable and are logged",
    "diagnostic": "all two-level indicators are explicitly binary; any MICE logged events are retained in the audit table"
  },
  "incident_disability_mi_sensitivity": {
    "estimand": "incident any ADL/IADL limitation after an observed baseline ADL/IADL-free frame",
    "cohorts": [
      "ELSA 6->7",
      "CHARLS 3->4",
      "HRS 10->11"
    ],
    "m": 5,
    "maxit": 3,
    "seed": 20260925,
    "methods": {
      "ordinal_adl_iadl": "polr where estimable; sparse-category multinomial fallback logged explicitly",
      "two_level_and_binary": "logreg.boot",
      "continuous_age_grip_bmi": "pmm"
    },
    "passive_recomputation": [
      "incident disability",
      "outcome-disjoint baseline FI",
      "four observed IC proxies"
    ],
    "summary": "positive incremental AUC and Brier improvement were retained across all three development cohorts; this is a missing-data sensitivity and does not replace the complete-case primary model or SHARE external validation",
    "diagnostic": "MICE logged sparse-category ordinal fallbacks and predictor-drop events are retained in ordinal_mi_disability_mice_log.csv; structural missingness is not recovered"
  },
  "claim_boundaries": {
    "proxy": "conditional incremental predictive validity with independent SHARE validation; not a universally transportable clinical prediction tool",
    "latent": "measurement-audit and cohort-specific structural evidence; no universal latent predictor, scalar invariance or latent mean ranking",
    "transport": "conditional because ELSA held-out delta AUC CI crosses zero, SHARE 6->8 has calibration intercept drift, and pooled-reference scaling can fail"
  },
